{
  "manifest_version": 3,
  "name": "WebMCP Inspector (Local UI Fork)",
  "description": "Local UI fork for inspecting and interacting with WebMCP tools",
  "version": "1.9.19",
  "minimum_chrome_version": "150.0.7861.0",
  "permissions": ["sidePanel", "activeTab", "scripting", "webNavigation", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
